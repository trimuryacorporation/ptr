# Email OTP delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Optional dedicated HMAC secret; JWT_ACCESS_SECRET is used if omitted
OTP_SECRET=
# SMS OTP delivery (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Used for local mobile numbers; international +country-code numbers are preferred
SMS_DEFAULT_COUNTRY_CODE=+91
